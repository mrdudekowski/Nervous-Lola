{
  "name": "nervouslola-website",
  "version": "1.0.0",
  "description": "Нервная Лола - Уникальная кофейня с характером",
  "scripts": {
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:css:fix": "stylelint \"assets/css/**/*.css\" --fix",
    "lint:css:report": "stylelint \"assets/css/**/*.css\" --formatter json > css-lint-report.json",
    "analyze:css": "node scripts/css-analyzer.js",
    "css:audit": "npm run lint:css && npm run analyze:css",
    "css:audit:fix": "npm run lint:css:fix && npm run css:audit",
    "css:watch": "nodemon --watch assets/css --exec \"npm run css:audit\"",
    "css:ci": "npm run css:audit -- --max-warnings 0",
    "test:html": "node scripts/html-validator.js",
    "test:js": "node scripts/js-analyzer.js",
    "test:performance": "node scripts/performance-test.js",
    "test:security": "node scripts/security-scan.js",
    "test:accessibility": "node scripts/accessibility-test.js",
    "qa:full": "npm run css:audit && npm run test:html && npm run test:js && npm run test:performance && npm run test:security && npm run test:accessibility",
    "build": "webpack --mode=production",
    "help:site-url": "node -e \"console.log('Продакшен с canonical/og:url/JSON-LD: npx cross-env SITE_URL=https://ваш-домен npm run build')\"",
    "build:dev": "webpack --mode=development",
    "dev": "webpack serve --mode=development",
    "analyze": "webpack-bundle-analyzer dist/main.*.js",
    "optimize:images": "node scripts/optimize-images.js",
    "compress:hero-images": "node scripts/compress-hero-images.js",
    "encode:assets-video": "node scripts/encode-assets-video-to-mp4.cjs",
    "optimize:css": "node scripts/optimize-css.js",
    "optimize:js": "node scripts/optimize-js.js",
    "optimize:all": "npm run optimize:images && npm run optimize:css && npm run optimize:js",
    "production:build": "npm run build && npm run qa:full",
    "css:migrate-hex": "node scripts/migrate-hex-colors.js",
    "css:reduce-specificity": "node scripts/reduce-specificity.js",
    "css:track-progress": "node scripts/css-optimization-tracker.js",
    "css:optimize:foundation": "npm run css:migrate-hex && npm run lint:css:fix",
    "css:optimize:structure": "npm run css:reduce-specificity && npm run css:track-progress structure",
    "css:optimize:all": "npm run css:optimize:foundation && npm run css:optimize:structure",
    "css:extract-critical": "node scripts/extract-critical-css.js",
    "css:critical": "npm run css:extract-critical && npm run lint:css:fix"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.23"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.8.4",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "css-tree": "^2.3.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.57.0",
    "ffmpeg-static": "^5.3.0",
    "glob": "^11.0.3",
    "html-validate": "^8.7.4",
    "html-webpack-plugin": "^5.5.3",
    "lighthouse": "^13.2.0",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.31",
    "postcss-loader": "^8.1.1",
    "sharp": "^0.33.5",
    "style-loader": "^4.0.0",
    "stylelint": "^16.23.1",
    "stylelint-config-standard": "^39.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  }
}
