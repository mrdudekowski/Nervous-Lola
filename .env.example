# Скопируйте в `.env` и подставьте значения. Файл `.env` не коммитится.

# Ключ JavaScript API Яндекс.Карт (подставляется при `npm run build` в HTML, см. webpack.config.js).
YANDEX_MAP_API_KEY=

# Опционально: канонический HTTPS URL сайта для canonical / og:url (см. README проекта).
# SITE_URL=https://example.com
